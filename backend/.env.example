# Variáveis lidas pelo profile padrão (dev) — src/main/resources/application.properties
# Todas têm um default de desenvolvimento embutido no properties (mesmos valores abaixo),
# então nenhuma delas é obrigatória para rodar local via docker-compose.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=logitrackpro
DB_USER=logitrackpro
DB_PASSWORD=logitrackpro

# Porta HTTP da aplicação (default 8080 se não definida)
PORT=8080

# Origem permitida por CORS (default http://localhost:4200 em dev)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Variáveis lidas pelo profile prod — src/main/resources/application-prod.properties
# Usadas em deploy (Render), configuradas como env vars/secrets nativos da plataforma,
# nunca via arquivo .env real. Sem default: a aplicação falha ao subir se ausentes.

# URL do banco no formato bruto do Render/Neon (postgres://user:senha@host:porta/db),
# convertida automaticamente para JDBC por RenderDatabaseUrlEnvironmentPostProcessor.
DATABASE_URL=postgres://usuario:senha@host:5432/nome_do_banco

# Origem do frontend em produção (default https://logitrackpro.vercel.app)
# CORS_ALLOWED_ORIGINS=https://logitrackpro.vercel.app
